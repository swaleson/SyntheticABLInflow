// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// ABL wind simulation in 1:400 scale
// Domain size  = 25m x 3.4m x 2.5m (x-, y-, z-directions )

// Domain size and number of cells.
xMin                    0.0;		// Minimum x-extent of domain (m).
yMin                   -1.7;		// Minimum y-extent of domain (m).
zMin                    0.0;		// Minimum z-extent of domain (m).

xMax                    25.0;		// Maximum x-extent of domain (m).
yMax                    1.7;		// Maximum y-extent of domain (m).
zMax                    2.5;		// Maximum z-extent of domain (m).

zMid					0.5;		// height lower prism layer (m).

nx                      500;		// Number of cells in x-direction for the whole tunnel.
ny                      68;		// Number of cells in y-direction side prism layers.
nz_t                    40;		// Number of cells in z-direction for top prism layers.
nz_b			20;			// Number of cells in z-direction for near ground prism layer.

